# Ambiente: development | production
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# PostgreSQL (usado pelo docker-compose e localmente)
DATABASE_URL=postgresql+psycopg2://oficina:oficina@localhost:5432/oficina
# JWT — altere em produção
JWT_SECRET=altere-este-segredo-em-producao-use-string-longa-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# CORS (opcional, separar por virgula)
CORS_ORIGINS=*

# Webhook para integrações externas (n8n, Zapier, e-mail)
WEBHOOK_API_KEY=altere-esta-chave-webhook-em-producao

# E-mail transacional (desligado por padrão em dev)
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=oficina@localhost
